# Private data: resumes, database, exports
private/

# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Real profiles hold personal details; only the template is committed
config/profiles/*.yaml
!config/profiles/example.yaml

# Labels show what each person wants; keep them local like profiles
tests/labels/*
!tests/labels/.gitkeep
