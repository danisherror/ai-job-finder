<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobfinder.bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>src.main</string>
        <string>bot</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/danishmahajan/Desktop/Claude_Project/AI Job Finder</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>   <!-- write log lines at once, so a crash keeps them -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Asia/Kolkata</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>                <!-- always running; restarted if it stops -->
    <key>ThrottleInterval</key>
    <integer>30</integer>  <!-- wait 30s before a restart, so a crash loop stays quiet -->
    <key>StandardOutPath</key>
    <string>/Users/danishmahajan/Desktop/Claude_Project/AI Job Finder/private/logs/bot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danishmahajan/Desktop/Claude_Project/AI Job Finder/private/logs/bot.log</string>
</dict>
</plist>
