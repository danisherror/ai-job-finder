# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat ID, for failure alerts and the weekly health summary
OPERATOR_TELEGRAM_CHAT_ID=

# Timezone used for schedules and digest times
TZ=Asia/Kolkata

# Job portal API keys (optional; a portal without its key fails its scan and the rest carry on)
# Jooble: request at jooble.org/api/about. A key from in.jooble.org also needs JOOBLE_API_URL=https://in.jooble.org/api/
JOOBLE_API_KEY=
# Careerjet: the API key from the Careerjet partner page
CAREERJET_API_KEY=
# Adzuna: free app ID and app key from developer.adzuna.com (then set active: true on Adzuna in sources.yaml)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Hosting (optional; see README "Hosting"). With these set, the database is Turso instead of private/jobs.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# A local file to keep a synced copy in, for fast reads (the daily run uses one); leave empty to query Turso directly
TURSO_REPLICA=
# Any long random string; the same value goes on Vercel. Telegram sends it with each message to the hosted bot
TELEGRAM_WEBHOOK_SECRET=
